// -*- mode: jsonc -*-
{
  "reload_on_style_change": true,
  "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 35, // Waybar height (to be removed for auto height)
  "margin": "0  5  5  5",
  "spacing": 5, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": ["ext/workspaces"],
  "modules-center": ["mpris"],
  "modules-right": [
    "memory",
    "cpu",
    "temperature",
    "pulseaudio",
    "network",
    "clock",
  ],
  "ext/workspaces": {
    "all-outputs": true,
    "on-click": "activate",
    "active-only": false,
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "interval": 1,
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 45,
    "status-icons": {
      "paused": " ",
      "playing": " ",
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "~/.config/waybar/music.sh > /dev/null 2>&1",
    "on-click-middle": "hyprctl dispatch togglespecialworkspace audio",
    "on-scroll-up": "playerctl previous",
    "on-scroll-down": "playerctl next",
    "tooltip": true,
    "tooltip-format": "{dynamic}",
  },
  "temperature": {
    "format": "{temperatureC:^3}°C ",
    "tooltip": false,
    "interval": 3,
  },
  "clock": {
    "interval": 1,
    "tooltip": false,
  },
  "cpu": {
    "format": "{usage:^3}% ",
    "tooltip": true,
    "interval": 3,
  },
  "memory": {
    "format": "{percentage:^3}% ",
    "interval": 3,
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    // "format-ethernet": "{ifname}: <span color='white'>{gwaddr}</span>",
    "format-ethernet": "Leaked IP: <span color='white'>{gwaddr}</span>",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "tooltip": false,
  },
  "pulseaudio": {
    "tooltip": false,
    "format": "{volume:^3}% <span size='125%'>{icon}</span>",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": "{volume:^3}% <span size='125%'>{icon}</span>",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "test": "{volume}%",
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"],
      "default-muted": "󰖁",
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle ",
    "on-click-right": "pgrep pwvucontrol > /dev/null 2>&1 && hyprctl dispatch togglespecialworkspace volumecontrol || pwvucontrol",
  },
}
